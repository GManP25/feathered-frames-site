---
// Shared viewer. Any element with data-lb opens it. Elements sharing data-lb-group form one slideshow.
// data-kind="photo" shows title, camera settings and the print request link; data-kind="post" shows the image alone.
---
<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="lb-stage">
    <span class="lb-count" id="lbCount"></span>
    <button class="lb-close" id="lbClose" aria-label="Close">&times;</button>
    <button class="lb-nav prev" id="lbPrev" aria-label="Previous image">&#8249;</button>
    <img class="lb-img" id="lbImg" alt="" />
    <button class="lb-nav next" id="lbNext" aria-label="Next image">&#8250;</button>
  </div>
  <div class="lb-panel">
    <div class="lb-title" id="lbTitle"></div>
    <div class="lb-exif" id="lbExif">
      <div><b id="eFocal">-</b><span>Focal length</span></div>
      <div><b id="eAp">-</b><span>Aperture</span></div>
      <div><b id="eSh">-</b><span>Shutter</span></div>
      <div><b id="eIso">-</b><span>ISO</span></div>
    </div>
    <div class="lb-gear" id="lbGear"></div>
    <a class="lb-print" id="lbPrint" href="/prints">Request this photograph as a print</a>
  </div>
</div>

<script>
  const lb = document.getElementById('lb')!;
  const lbImg = document.getElementById('lbImg') as HTMLImageElement;
  const $ = (id: string) => document.getElementById(id)!;

  // Blog posts: make every inline photograph open in the viewer
  document.querySelectorAll<HTMLImageElement>('.post-content img[data-zoom]').forEach(img => {
    img.dataset.lb = '';
    img.dataset.lbGroup = 'post';
    img.dataset.kind = 'post';
    img.dataset.full = img.getAttribute('src') || '';
    img.dataset.thumb = img.dataset.full;
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', 'View larger');
  });

  let list: HTMLElement[] = [];
  let idx = 0;
  let lastFocus: Element | null = null;

  function show(i: number) {
    idx = (i + list.length) % list.length;
    const t = list[idx];
    const d = t.dataset;
    const isPhoto = d.kind === 'photo';
    lb.classList.toggle('simple', !isPhoto);
    const sameSrc = d.thumb === d.full;
    lbImg.classList.toggle('blur', !sameSrc);
    lbImg.src = d.thumb!;
    lbImg.alt = d.title || '';
    if (!sameSrc) {
      const full = new Image();
      full.onload = () => { if (list[idx] === t) { lbImg.src = full.src; lbImg.classList.remove('blur'); } };
      full.src = d.full!;
    }
    $('lbCount').textContent = list.length > 1 ? `${idx + 1} / ${list.length}` : '';
    if (!isPhoto) return;

    $('lbTitle').innerHTML = '';
    const name = document.createElement('span'); name.textContent = d.title || '';
    $('lbTitle').appendChild(name);
    if (d.loc) { const s = document.createElement('small'); s.textContent = d.loc; $('lbTitle').appendChild(s); }
    const ex = d.exif ? JSON.parse(d.exif) : null;
    const exBox = $('lbExif');
    if (ex) {
      exBox.style.display = '';
      $('eFocal').textContent = ex.focal || '-';
      $('eAp').textContent = ex.aperture || '-';
      $('eSh').textContent = ex.shutter || '-';
      $('eIso').textContent = (ex.iso || '-').replace('ISO ', '');
      $('lbGear').textContent = [ex.camera, ex.lens].filter(Boolean).join('  •  ');
      $('lbGear').className = 'lb-gear';
    } else {
      exBox.style.display = 'none';
      $('lbGear').textContent = 'Camera settings are not available for this photograph.';
      $('lbGear').className = 'lb-none';
    }
    ($('lbPrint') as HTMLAnchorElement).href = '/prints?photo=' + encodeURIComponent(d.id || '');
  }
  function open(t: HTMLElement) {
    const g = t.dataset.lbGroup || 'default';
    list = Array.from(document.querySelectorAll<HTMLElement>('[data-lb]')).filter(x => (x.dataset.lbGroup || 'default') === g && !x.hidden);
    lastFocus = document.activeElement;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
    show(Math.max(0, list.indexOf(t)));
    $('lbClose').focus();
  }
  function close() {
    lb.classList.remove('open');
    document.body.style.overflow = '';
    (lastFocus as HTMLElement | null)?.focus?.();
  }
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]');
    if (t) open(t);
  });
  document.addEventListener('keydown', (e) => {
    if (lb.classList.contains('open')) {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(idx - 1);
      else if (e.key === 'ArrowRight') show(idx + 1);
    } else if (e.key === 'Enter' && (e.target as HTMLElement).matches?.('img[data-lb]')) {
      open(e.target as HTMLElement);
    }
  });
  $('lbClose').addEventListener('click', close);
  $('lbPrev').addEventListener('click', () => show(idx - 1));
  $('lbNext').addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => { if ((e.target as HTMLElement).classList.contains('lb-stage')) close(); });
  let sx = 0;
  lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
  });
</script>
