---
// Magazine-style Z-pattern list of journal posts: image left and text right, then flipped, and so on.
import { fmtDate, slugify } from '../lib/journal';
const { posts } = Astro.props;
---
<div class="zlist">
  {posts.map((post: any, i: number) => (
    <article class="z-item">
      <a class="z-media" href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
        {post.data.heroImage && <img src={post.data.heroImage} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />}
      </a>
      <div class="z-text">
        <div class="z-kicker">
          <span class="z-no">{String(i + 1).padStart(2, '0')}</span>
          <a class="z-cat" href={`/blog/category/${slugify(post.data.category)}`}>{post.data.category}</a>
        </div>
        <time class="z-date" datetime={post.data.date.toISOString()}>
          <svg class="ico-leaf" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4C11 4 5 8.5 5 15c0 1.6.5 3 1.4 4.1C7.6 12.8 12 9.4 17 8.2 12.8 10.4 9.6 13.8 7.4 18.4c.9.4 1.9.6 3 .6 6 0 9.6-5.5 9.6-15z"/></svg>
          {fmtDate(post.data.date)}
        </time>
        <h2 class="z-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
        {post.data.excerpt && <p class="z-excerpt">{post.data.excerpt}</p>}
        <a class="z-more" href={`/blog/${post.id}`}>Read the story <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>
  ))}
</div>
