---
import '../styles/global.css';

interface Props { title: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; published?: Date; }
const SITE = 'https://www.gauravsfeatheredframes.com';
const siteTitle = "Gaurav's Feathered Frames";
const defaultDesc = "Bird and wildlife photography from India by Gaurav Pathak: snow leopards, raptors and Himalayan birds, with camera settings and field stories.";
const { title, description = defaultDesc, image = "/images/portfolio/winter-wonderland-spiti/bearded-vulture-or-lammergeier.jpg", imageAlt = "Bearded vulture in flight over the Spiti Valley, India", type = 'website', published } = Astro.props;

// Keep the browser title within 60 characters and the description within 160, cutting at a word boundary
const clip = (s: string, max: number) => {
  const clean = s.replace(/\s+/g, ' ').replace(/[\u2013\u2014]/g, ',').replace(/…$/, '').trim();
  if (clean.length <= max) return clean;
  return clean.slice(0, max - 1).replace(/[\s,;:.-]+\S*$/, '').trim() + '…';
};
const isHome = Astro.url.pathname === '/';
let fullTitle = isHome ? `${siteTitle} | Bird & Wildlife Photography` : `${title} | ${siteTitle}`;
if (fullTitle.length > 60) fullTitle = clip(title, 60);
const metaDesc = clip(description, 160);
const path = Astro.url.pathname.replace(/index\.html$/, '');
const canonical = SITE + (path.endsWith('/') || path === '' ? path : path + '/').replace(/^\/\/$/, '/');
const abs = (u: string) => (u.startsWith('http') ? u : SITE + u);
const ogImage = abs(image);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': SITE + '/#site', name: siteTitle, url: SITE + '/', inLanguage: 'en-IN', publisher: { '@id': SITE + '/#person' } },
    { '@type': 'Person', '@id': SITE + '/#person', name: 'Gaurav Pathak', url: SITE + '/', jobTitle: 'Wildlife and bird photographer', sameAs: ['https://www.instagram.com/gauravsfeatheredframes/'] },
  ],
};
const p = isHome ? '' : '/';
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDesc} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content="Gaurav Pathak" />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt} />
  {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
  {type === 'article' && <meta property="article:author" content="Gaurav Pathak" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDesc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <meta name="theme-color" content="#141614" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🪶</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('ff-theme'); } catch (e) {}
      if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body data-home={isHome ? 'true' : 'false'}>
  <header class={`site-header ${isHome ? '' : 'solid'}`} id="siteHeader">
    <div class="wrap">
      <a href="/" class="brand">Gaurav's Feathered Frames</a>
      <nav class="nav-links" id="navLinks" aria-label="Main">
        <a href={`${p}#gallery`} data-nav="gallery">Gallery</a>
        <a href={isHome ? "#journal" : "/blog"} data-nav="journal">Journal</a>
        <a href="/life-list" data-nav="life-list">Life List</a>
        <a href={`${p}#about`}>About</a>
        <a href="/prints" data-nav="prints">Prints</a>
        <a href={`${p}#contact`}>Contact</a>
      </nav>
      <div class="header-actions">
        <button class="icon-btn" id="themeToggle" aria-label="Switch between light and dark mode" title="Light / dark">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="icon-btn nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div>&copy; {new Date().getFullYear()} Gaurav Pathak. All photographs are protected by copyright.</div>
      <div class="foot-links">
        <a href={`${p}#gallery`}>Gallery</a>
        <a href="/blog">Journal</a>
        <a href="/life-list">Life List</a>
        <a href="/prints">Prints</a>
        <a href={`${p}#contact`}>Contact</a>
      </div>
      <div class="socials">
        <a href="https://www.instagram.com/gauravsfeatheredframes" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".8" fill="currentColor"/></svg>
        </a>
        <a href={`${p}#contact`} aria-label="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
        </a>
      </div>
    </div>
  </footer>

  <script>
    const root = document.documentElement;

    // Deter casual saving: block the right-click menu and dragging on photographs and videos.
    const protectedMedia = 'img, video, .tile, .lb-stage, .inline-media, .z-media, .card, .thumb';
    document.addEventListener('contextmenu', (e) => {
      if ((e.target as Element).closest?.(protectedMedia)) e.preventDefault();
    });
    document.addEventListener('dragstart', (e) => {
      if ((e.target as Element).closest?.('img, video')) e.preventDefault();
    });
    document.getElementById('themeToggle')?.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('ff-theme', next); } catch (e) {}
    });

    const navToggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    navToggle?.addEventListener('click', () => {
      const open = navLinks?.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', String(!!open));
    });
    navLinks?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) navLinks.classList.remove('open'); });

    // Transparent header over the hero on the home page, solid once scrolled
    const header = document.getElementById('siteHeader');
    if (document.body.dataset.home === 'true' && header) {
      const hero = document.querySelector('.hero');
      const update = () => {
        const limit = hero ? hero.getBoundingClientRect().bottom - 110 : 0;
        header.classList.toggle('solid', limit < 0);
      };
      const cue = document.querySelector('.scroll-cue');
      const hideCue = () => cue?.classList.toggle('hide', scrollY > 40);
      addEventListener('scroll', hideCue, { passive: true }); hideCue();
      update();
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);

      // highlight the active section in the nav
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="#"]'));
      const targets = links.map(a => document.querySelector(a.getAttribute('href')!)).filter(Boolean) as Element[];
      const io = new IntersectionObserver((entries) => {
        entries.forEach(en => {
          if (en.isIntersecting) {
            links.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + en.target.id));
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      targets.forEach(t => io.observe(t));
    }
    if (location.pathname.startsWith('/blog')) {
      document.querySelector('.nav-links a[data-nav="journal"]')?.classList.add('active');
    }

    if (location.pathname.startsWith('/gallery')) {
      document.querySelector('.nav-links a[data-nav="gallery"]')?.classList.add('active');
    }
    if (location.pathname.startsWith('/life-list')) {
      document.querySelector('.nav-links a[data-nav="life-list"]')?.classList.add('active');
    }
    if (location.pathname.startsWith('/prints')) {
      document.querySelector('.nav-links a[data-nav="prints"]')?.classList.add('active');
    }

    // Forms post to Netlify in the background and confirm on the page
    document.querySelectorAll<HTMLFormElement>('form[data-ajax]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const status = form.querySelector<HTMLElement>('.form-status');
        if (btn) btn.disabled = true;
        if (status) { status.className = 'form-status'; status.textContent = 'Sending...'; }
        try {
          const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
          const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          if (status) { status.className = 'form-status ok'; status.textContent = 'Thank you. Your message has been sent and I will reply by email.'; }
        } catch {
          if (status) { status.className = 'form-status err'; status.textContent = 'Sorry, that did not go through. Please try again, or message me on Instagram.'; }
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    });
  </script>
</body>
</html>
