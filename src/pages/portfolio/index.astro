---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const portfolio = await getCollection('portfolio');
---
<BaseLayout title="Portfolio" description="Wildlife and bird photography collections from across India.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Portfolio</span>
      <h1 style="margin-bottom: 36px;">Collections</h1>
      <div class="grid grid-3">
        {portfolio.map(p => (
          <a class="card" href={`/portfolio/${p.data.slug}`}>
            <img src={p.data.coverImage} alt={p.data.title} loading="lazy" />
            <div class="card-overlay">
              <div>
                <h3>{p.data.title}</h3>
                <span class="count">{p.data.photos.length} photographs</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
