---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getPosts } from '../../lib/journal';
const categories = await getCategories();
const total = (await getPosts()).length;
---
<BaseLayout title="Journal" description="Trip reports and field lessons from nature and wildlife photography across India.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Journal</span>
      <h1>Trip reports &amp; field lessons</h1>
    </div>
  </section>
  <div class="filter-bar" role="navigation" aria-label="Journal categories">
    <div class="wrap">
      <a class="chip" href="/blog" aria-current="page">All<span class="n">{total}</span></a>
      {categories.map(c => <a class="chip" href={`/blog/category/${c.slug}`}>{c.name}<span class="n">{c.count}</span></a>)}
    </div>
  </div>
  <section class="section" style="padding-top: 40px;">
    <div class="wrap">
      <div class="cards two">
        {categories.map(c => (
          <a class="card" href={`/blog/category/${c.slug}`}>
            {c.cover && <img src={c.cover} alt="" loading="lazy" decoding="async" />}
            <span class="card-text"><h3>{c.name}</h3><span>{c.count} {c.count === 1 ? 'post' : 'posts'}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
