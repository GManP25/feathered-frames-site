---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getPosts } from '../../lib/journal';
import JournalList from '../../components/JournalList.astro';
const categories = await getCategories();
const posts = await getPosts();
const total = posts.length;
---
<BaseLayout title="Journal" description="Trip reports and field lessons from nature and wildlife photography across India.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Journal</span>
      <h1>Trip reports &amp; field lessons</h1>
    </div>
  </section>
  <div class="filter-bar" role="navigation" aria-label="Journal categories">
    <div class="wrap">
      <a class="chip" href="/blog" aria-current="page">All<span class="n">{total}</span></a>
      {categories.map(c => <a class="chip" href={`/blog/category/${c.slug}`}>{c.name}<span class="n">{c.count}</span></a>)}
    </div>
  </div>
  <section class="section z-section">
    <div class="wrap">
      <JournalList posts={posts} />
    </div>
  </section>
</BaseLayout>
