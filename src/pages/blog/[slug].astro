---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { title, date, heroImage, excerpt, category } = post.data;
const { Content } = await render(post);
const when = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={title} description={excerpt} image={heroImage}>
  <article>
    <div class="post-top">
      <div class="wrap post-body">
        <div class="meta"><span class="tag">{category}</span><time datetime={date.toISOString()}>{when}</time></div>
        <h1>{title}</h1>
      </div>
    </div>
    <div class="post-content"><Content /><a class="back-link" href="/blog">&larr; Back to the journal</a></div>
  </article>
</BaseLayout>
