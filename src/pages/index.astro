---
import BaseLayout from '../layouts/BaseLayout.astro';
import collections from '../data/collections.json';
import { getCategories } from '../lib/journal';

const categories = await getCategories();
const hero = '/images/portfolio/winter-wonderland-spiti/bearded-vulture-or-lammergeier.jpg';
---
<BaseLayout title="Gaurav's Feathered Frames" description="Nature and wildlife photography from India: birds, mammals and landscapes, with field notes from every trip.">
  <section class="hero" style={`background-image:url(${hero}); background-position: 32% 42%;`} id="top">
    <div class="hero-inner">
      <h1>Gaurav Pathak</h1>
      <p class="sub">Nature &amp; Wildlife Photography</p>
    </div>
    <a class="scroll-cue" href="#gallery" aria-label="Scroll to the gallery">Scroll</a>
  </section>

  <section id="gallery" class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Gallery</span>
        <h2>Frames from the field</h2>
        <p>Six collections from across India. Choose one to read its story and view every photograph, along with the camera settings behind it.</p>
      </div>
      <div class="cards">
        {collections.map(c => (
          <a class="card" href={`/gallery/${c.slug}`}>
            <img src={`/images/portfolio/${c.slug}/cover.jpg`} alt="" loading="lazy" decoding="async" />
            <span class="card-text"><h3>{c.title}</h3><span>{c.count} photographs</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="journal" class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Journal</span>
        <h2>Trip reports &amp; field lessons</h2>
        <p>Stories from long drives, cold mornings and the occasional lucky frame, along with what I have learnt about photographing wildlife.</p>
      </div>
      <div class="cards two">
        {categories.map(c => (
          <a class="card" href={`/blog/category/${c.slug}`}>
            {c.cover && <img src={c.cover} alt="" loading="lazy" decoding="async" />}
            <span class="card-text"><h3>{c.name}</h3><span>{c.count} {c.count === 1 ? 'post' : 'posts'}</span></span>
          </a>
        ))}
      </div>
      <a class="more-link" href="/blog">Browse the journal</a>
    </div>
  </section>

  <section id="about" class="section">
    <div class="wrap about-grid">
      <div>
        <span class="eyebrow">About</span>
        <h2 style="font-size: clamp(1.9rem, 3.4vw, 2.7rem);">Gaurav Pathak</h2>
      </div>
      <div class="about-copy">
        <p>I photograph birds and wildlife across India, from the grasslands of Assam to the high-altitude cold deserts of Spiti. What began as a way to slow down has become a habit of travelling far and waiting long.</p>
        <p>The pictures here are the result of those trips. The journal holds the stories behind them, including the misses and the odd moment that makes the wait worthwhile. I post regularly on <a href="https://www.instagram.com/gauravsfeatheredframes" target="_blank" rel="noopener">Instagram</a>, and a small collection of <a href="/prints">fine-art prints</a> is on its way.</p>
        <div class="gear">
          <span><b>Camera</b> Canon EOS R5</span>
          <span><b>Main lens</b> RF 600mm F4 L IS USM</span>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section section-alt">
    <div class="wrap about-grid">
      <div>
        <span class="eyebrow">Contact</span>
        <h2 style="font-size: clamp(1.9rem, 3.4vw, 2.7rem);">Say hello</h2>
        <p style="color: var(--text-dim); margin-top: 12px;">For collaborations, trip questions or print enquiries (you can also <a href="/prints">request a print</a> directly) or questions about a trip, send a message and I will reply as soon as I can.</p>
      </div>
      <form class="form" name="contact" method="POST" action="/" data-netlify="true" data-ajax netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p style="display:none;"><label>Leave this empty <input name="bot-field" /></label></p>
        <div><label for="name">Name</label><input type="text" id="name" name="name" required autocomplete="name" /></div>
        <div><label for="email">Email</label><input type="email" id="email" name="email" required autocomplete="email" /></div>
        <div><label for="message">Message</label><textarea id="message" name="message" rows="5" required></textarea></div>
        <div><button type="submit" class="btn">Send message</button></div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>
