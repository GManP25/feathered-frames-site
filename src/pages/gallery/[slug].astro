---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import photosData from '../../data/photos.json';
import collections from '../../data/collections.json';

export function getStaticPaths() {
  return collections.map(c => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const photos: any[] = photosData.filter((p: any) => p.collectionSlug === c.slug);
// Tidy lens names for the hover label (display only; the data stays as recorded)
const lensName = (l?: string) => (l || '').replace(/\s+back\s.*$/i, '').replace(/\+\s*(EXTENDER RF1\.4x|RF 1\.4x extender)/i, '+ 1.4x');
const paras = c.description.split('\n').filter(Boolean);
---
<BaseLayout title={c.title} description={c.description.slice(0, 160)} image={`/images/portfolio/${c.slug}/cover.jpg`}>
  <section class="page-head">
    <div class="wrap">
      <a class="back-link" href="/#gallery">&larr; All collections</a>
      <span class="eyebrow" style="margin-top:18px">Collection &middot; {photos.length} photographs</span>
      <h1>{c.title}</h1>
      <div class="col-note-inline">
        {paras.map(t => <p>{t}</p>)}
        {c.details.filter(Boolean).length > 0 && <p class="trip">{c.details.filter(Boolean).join(' • ').replace(/\n/g, ' • ')}</p>}
      </div>
    </div>
  </section>
  <div class="filter-bar" role="navigation" aria-label="Collections">
    <div class="wrap">
      <a class="chip" href="/#gallery">All collections</a>
      {collections.map(x => (
        <a class="chip" href={`/gallery/${x.slug}`} aria-current={x.slug === c.slug ? 'page' : undefined}>{x.title}<span class="n">{x.count}</span></a>
      ))}
    </div>
  </div>
  <div class="wrap">
    <div class="gallery" id="gallery-grid">
      {photos.map((p, i) => (
        <button
          class="tile" type="button" data-lb data-lb-group="gallery" data-kind="photo" data-id={p.id} data-w={p.w} data-h={p.h} data-need={p.needs.join(', ')}
          data-full={p.image} data-thumb={p.thumb} data-title={p.title} data-loc={p.location} data-exif={p.exif ? JSON.stringify(p.exif) : ''}
          style={`background-image:url(${p.lqip}); aspect-ratio:${p.w}/${p.h}`}
          aria-label={`Open ${p.title}`}
        >
          <img src={p.thumb} width={p.w} height={p.h} alt={`${p.title}${p.location ? ', ' + p.location : ''}`} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
          <span class="tile-info">
            <span class="tile-title">{p.title}</span>
            {p.scientificName && <span class="tile-sci">{p.scientificName}</span>}
            {p.exif && (p.exif.lens || p.exif.aperture || p.exif.shutter) && (
              <span class="tile-specs">
                {p.exif.lens && <span class="spec spec-lens"><span class="spec-k">Lens</span><span class="spec-v">{lensName(p.exif.lens)}</span></span>}
                {p.exif.aperture && <span class="spec"><span class="spec-k">Aperture</span><span class="spec-v">{p.exif.aperture}</span></span>}
                {p.exif.shutter && <span class="spec"><span class="spec-k">Shutter</span><span class="spec-v">{p.exif.shutter}</span></span>}
              </span>
            )}
          </span>
        </button>
      ))}
    </div>
  </div>
  <script is:inline>
    // Asymmetric masonry: unequal column widths (set in CSS), staggered starts, each frame keeps its native aspect ratio.
    // Frames stay in their original order in the page, so the lightbox slideshow order is unchanged.
    (function () {
      var g = document.getElementById('gallery-grid');
      if (!g) return;
      var U = 4, GAP = 28, OFFSETS = { 3: [0, 96, 40], 2: [0, 72], 1: [0] };
      function layout() {
        g.classList.add('is-masonry');
        var tr = getComputedStyle(g).gridTemplateColumns.split(' ').map(parseFloat);
        var n = tr.length, gap = n === 1 ? 24 : (n === 2 ? 22 : GAP);
        var rows = (OFFSETS[n] || [0]).map(function (o) { return Math.round(o / U); });
        g.querySelectorAll('.tile').forEach(function (t) {
          var c = 0;
          for (var i = 1; i < n; i++) if (rows[i] < rows[c]) c = i;
          var h = tr[c] * (+t.dataset.h) / (+t.dataset.w);
          var span = Math.ceil((h + gap) / U);
          t.style.gridColumn = String(c + 1);
          t.style.gridRow = (rows[c] + 1) + ' / span ' + span;
          rows[c] += span;
        });
      }
      var raf;
      layout();
      window.addEventListener('resize', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(layout); });
    })();
  </script>
  <Lightbox />
  <script>
    document.querySelectorAll<HTMLButtonElement>('.tile').forEach(t => {
      const img = t.querySelector('img')!;
      const done = () => img.classList.add('loaded');
      if (img.complete && img.naturalWidth) done(); else img.addEventListener('load', done, { once: true });
    });
    // Review mode (?review=1): flags photographs that still need a title, location or camera settings
    if (new URLSearchParams(location.search).get('review') === '1') {
      document.body.classList.add('review');
      document.querySelectorAll<HTMLButtonElement>('.tile').forEach(t => {
        const need = t.dataset.need;
        if (need) { const b = document.createElement('span'); b.className = 'review-badge'; b.textContent = 'Needs: ' + need; t.appendChild(b); }
      });
    }
    // keep the current collection chip in view on small screens
    document.querySelector('.chip[aria-current]')?.scrollIntoView({ inline: 'center', block: 'nearest' });
  </script>
</BaseLayout>
